FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      bottomValues;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            surfaces;
libs            ("libsampling.so");
writeControl    writeTime;
surfaceFormat   raw;

#include "../fieldDef"

fields          $wallValuesFields;

surfaces
(
    bottomValues
    {
        type            patch;
        patches         (bottomWall);
        interpolate     false;
    }
);

